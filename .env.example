# ─────────────────────────────────────────────────────────────
# Django
# ─────────────────────────────────────────────────────────────
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# Required when DEBUG is off — the app refuses to start with a missing/placeholder key.
SECRET_KEY=your-secret-key-here
# DEBUG defaults to False. Turn it on for local development only; never in production.
DEBUG=True
# Comma-separated hostnames you serve. Never use "*". ngrok domains are allowed automatically when DEBUG=True.
ALLOWED_HOSTS=localhost,127.0.0.1

# Production HTTPS (applied when DEBUG=False; TLS is expected to terminate at your proxy):
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False
# TRUST_X_FORWARDED_FOR=False     # True only behind a proxy that overwrites X-Forwarded-For

# Extra HTTPS origins trusted for CSRF (comma-separated), e.g. a custom tunnel
# domain. ngrok domains (*.ngrok-free.dev/.app/.io) are already trusted in settings.
# CSRF_TRUSTED_ORIGINS=https://your-domain.com

# ─────────────────────────────────────────────────────────────
# Clinic
# ─────────────────────────────────────────────────────────────
# IANA timezone of the practice. Drives the agent's clock, calendar slots and
# the dashboard's "today". Business hours live in settings.CLINIC_BUSINESS_HOURS.
CLINIC_TIMEZONE=America/New_York

# ─────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────
# Set USE_SQLITE=True to run locally with a db.sqlite3 file (no Postgres/Docker needed).
# Leave it unset/blank to use the Postgres settings below (Docker Compose / production).
USE_SQLITE=

DB_NAME=ai_receptionist
DB_USER=postgres
DB_PASSWORD=change-me            # required by docker-compose; use a strong value
DB_HOST=db
DB_PORT=5432

# ─────────────────────────────────────────────────────────────
# OpenAI — the agent's LLM (get a key at https://platform.openai.com/api-keys)
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o          # or gpt-4o-mini for lower cost / latency

# ─────────────────────────────────────────────────────────────
# Vapi — voice transport (https://dashboard.vapi.ai)
# ─────────────────────────────────────────────────────────────
VAPI_API_KEY=your-vapi-private-api-key      # server/private key
VAPI_PUBLIC_KEY=your-vapi-public-key        # browser-safe public key (landing-page voice widget)
VAPI_ASSISTANT_ID=your-vapi-assistant-id    # the assistant the web widget connects to
# Shared secret Vapi must send to this server. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Configure it as the Server URL secret AND the Custom LLM credential in Vapi.
VAPI_SECRET=change-me

# ─────────────────────────────────────────────────────────────
# Google Calendar (service-account JSON in the project root)
# ─────────────────────────────────────────────────────────────
GOOGLE_CALENDAR_CREDENTIALS=google-calendar-credentials.json
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com  # or your Gmail for the primary calendar

# ─────────────────────────────────────────────────────────────
# Twilio SMS (https://twilio.com/console)
# ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ─────────────────────────────────────────────────────────────
# Logging & data retention
# ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                 # DEBUG logs (masked) tool payloads — avoid in production
CALL_DATA_RETENTION_DAYS=90    # used by `manage.py purge_call_data`
